<UserControl x:Class="MyProgram.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:MyProgram.Helpers"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             prism:ViewModelLocator.AutoWireViewModel="True"
             x:Name="LoginPage"
             mc:Ignorable="d">
    <Grid>
        <!-- 1. 每日一图背景（自动铺满整个窗口） -->
        <Image x:Name="BgImage" Stretch="UniformToFill" Source="{Binding BackgroundImageSource}"/>

        <!-- 2. 半透明遮罩（自动跟随背景） -->
        <Border Background="#66000000" />

        <!-- 3. 自适应布局核心：使用Grid划分比例 -->
        <Grid Opacity="0.9">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*"/>
                <!-- 上方留白，占80%高度 -->
                <RowDefinition Height="2.4*"/>
                <!-- 中间内容区，占240%高度（核心区域） -->
                <RowDefinition Height="0.8*"/>
                <!-- 下方留白，占80%高度 -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <!-- 左侧留白 -->
                <ColumnDefinition Width="2*"/>
                <!-- 中间内容区 -->
                <ColumnDefinition Width="0.5*"/>
                <!-- 右侧留白 -->
            </Grid.ColumnDefinitions>

            <!-- 4. 登录卡片（放在Grid的中间单元格） -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="Transparent" 
                    CornerRadius="15" 
                    Effect="{StaticResource DropShadowEffect}"
                    HorizontalAlignment="Stretch"  
                VerticalAlignment="Stretch"
                MaxWidth="500"
                MaxHeight="600">
                <!-- 限制最大高度 -->

                <!-- 5. 使用Viewbox实现内容等比例缩放（字体、输入框都会随窗口变大变小） -->
                <Viewbox Stretch="Uniform" Margin="40">
                    <!-- 6. 内部用StackPanel保持垂直排列，这里的宽度高度是"基准尺寸"，会被Viewbox缩放 -->
                    <StackPanel Width="320" MinHeight="300">
                        <TextBlock Text="工业物联网监控平台" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="#333" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,50"/>

                        <!-- 用户名输入框（移除固定Height，用MinHeight保证最小高度） -->
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" 
                                 Style="{StaticResource ModernTextBoxStyle}" 
                                 helpers:TextBoxHelper.PlaceholderText="请输入用户名"
                                 MinHeight="50"
                                 FontSize="16"/>

                        <!-- 密码输入框 -->
                        <PasswordBox Margin="0,25,0,0" 
                                     Style="{StaticResource ModernPasswordBoxStyle}"
                                     helpers:PasswordHelper.Attach="True"
                                     helpers:PasswordHelper.PlaceholderText="请输入密码"
                                     helpers:PasswordHelper.Password="{Binding Password, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                     MinHeight="50"
                                     FontSize="16"/>

                        <!-- 登录按钮 -->
                        <Button Content="安全登录" 
                                Command="{Binding LoginCommand}" 
                                MinHeight="55" 
                                Background="#0078D4" 
                                Foreground="White" 
                                FontSize="18" 
                                Margin="0,40,0,20" 
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder"
                                            CornerRadius="10"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" TargetName="BtnBorder" Value="#005A9E"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" TargetName="BtnBorder" Value="#004578"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 注册导航 -->
                        <TextBlock Text="还没有账号？立即注册" 
                                   HorizontalAlignment="Center" 
                                   Foreground="#0078D4" 
                                   FontSize="16"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding GoToRegisterCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</UserControl>