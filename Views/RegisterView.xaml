<UserControl x:Class="MyProgram.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyProgram.Views"
             xmlns:helpers="clr-namespace:MyProgram.Helpers"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadImageCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <!-- 背景图 (代码后台设置) -->
        <Image x:Name="BackgroundImage" Source="{Binding BackgroundImageSource}" Stretch="UniformToFill" />

        <!-- 半透明遮罩 -->
        <Grid Background="#80000000">
            <!-- 居中表单容器 -->
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="10"
                Effect="{StaticResource DropShadowEffect}">
                <Viewbox Stretch="Uniform" Margin="40">
                    <!-- 核心表单Grid：用行定义规整布局，替代硬编码Margin -->
                    <Grid MinWidth="300" MinHeight="400">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 标题行 -->
                            <RowDefinition Height="*"/>    <!-- 表单区域 自适应剩余空间 -->
                            <RowDefinition Height="Auto"/> <!-- 底部跳转链接行 -->
                        </Grid.RowDefinitions>

                        <!-- 标题 -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,20,0,30"
                            HorizontalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Text="注册" />

                        <!-- 表单输入区域：独立Grid+行定义，每个输入项独占一行 -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 用户名 -->
                                <RowDefinition Height="Auto"/> <!-- 密码 -->
                                <RowDefinition Height="Auto"/> <!-- 确认密码 -->
                                <RowDefinition Height="Auto"/> <!-- 注册按钮 -->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 用户名输入项 -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,5"
                                    FontSize="14"
                                    Foreground="#FFFFFF"
                                    Text="用户名" />
                                <TextBox
                                    Grid.Row="1"
                                    MinHeight="40"
                                    Background="#444444"
                                    BorderBrush="#666666"
                                    BorderThickness="1"
                                    Foreground="#FFFFFF"
                                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                    TextAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    TextWrapping="NoWrap"
                                    helpers:TextBoxHelper.PlaceholderText="请输入用户名" />
                            </Grid>

                            <!-- 密码输入项 -->
                            <Grid Grid.Row="1" Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,5"
                                    FontSize="14"
                                    Foreground="#FFFFFF"
                                    Text="密码" />
                                <PasswordBox
                                    x:Name="PasswordBox"
                                    Grid.Row="1"
                                    MinHeight="40"
                                    Background="#444444"
                                    BorderBrush="#666666"
                                    BorderThickness="1"
                                    Foreground="#FFFFFF"
                                    VerticalContentAlignment="Center"
                                    helpers:PasswordHelper.Attach="True"
                                    helpers:PasswordHelper.Password="{Binding Password, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                            </Grid>

                            <!-- 确认密码输入项 -->
                            <Grid Grid.Row="2" Margin="0,0,0,30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,5"
                                    FontSize="14"
                                    Foreground="#FFFFFF"
                                    Text="确认密码" />
                                <PasswordBox
                                    x:Name="ConfirmPasswordBox"
                                    Grid.Row="1"
                                    MinHeight="40"
                                    Background="#444444"
                                    BorderBrush="#666666"
                                    BorderThickness="1"
                                    Foreground="#FFFFFF"
                                    VerticalContentAlignment="Center"
                                    helpers:PasswordHelper.Attach="True"
                                    helpers:PasswordHelper.Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                            </Grid>

                            <!-- 注册按钮 -->
                            <Button
                                Grid.Row="3"
                                MinHeight="40"
                                HorizontalAlignment="Stretch"
                                Background="#0078D7"
                                BorderBrush="#0078D7"
                                BorderThickness="1"
                                Command="{Binding RegisterCommand}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#FFFFFF"
                                Style="{StaticResource ButtonStyle}"
                                Content="注册" />
                        </Grid>

                        <!-- 底部去登录链接 -->
                        <Button
                            Grid.Row="2"
                            Margin="0,30,0,20"
                            MinHeight="30"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{Binding GoToLoginCommand}"
                            FontSize="12"
                            Foreground="#0078D7"
                            Style="{StaticResource ButtonStyle}"
                            Content="已有账号？去登录" />
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</UserControl>