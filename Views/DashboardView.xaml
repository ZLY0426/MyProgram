<UserControl x:Class="MyProgram.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:customcontrols="clr-namespace:MyProgram.CustomControl"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">
    <UserControl.Resources>
        <!-- 导航按钮统一样式 -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34495E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1ABC9C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧导航栏：权重 0.15 -->
            <ColumnDefinition Width="0.15*" MinWidth="180"/>
            <!-- 右侧内容区：权重 0.85 -->
            <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：导航菜单 ==================== -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel>
                <!-- 1. 标题/Logo区 -->
                <Border Background="#1A252F" Padding="15,20">
                    <TextBlock 
                        Text="工业监控系统" 
                        FontSize="18" 
                        FontWeight="Bold" 
                        Foreground="White"/>
                </Border>

                <!-- 2. 导航按钮列表 -->
                <StackPanel Margin="0,10">
                    <!-- 导航按钮1：Modbus RTU -->
                    <Button 
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ModbusRtuView"
                        Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <!-- 图标占位符：你可以换成 Image 或 Path -->
                            <TextBlock Text="📡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Modbus RTU" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 导航按钮2：Modbus TCP -->
                    <Button 
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ModbusTcpView"
                        Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Modbus TCP" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 导航按钮3：运行日志 -->
                    <Button 
                        Command="{Binding NavigateCommand}"
                        CommandParameter="LogView"
                        Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="运行日志" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 右侧：Prism Region 内容区 ==================== -->
        <customcontrols:AnimatedContentControl 
            Grid.Column="1"
            prism:RegionManager.RegionName="DashboardRegion"/>
    </Grid>


</UserControl>
