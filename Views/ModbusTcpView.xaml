<UserControl x:Class="MyProgram.Views.ModbusTcpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:helpers="clr-namespace:MyProgram.Helpers"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:convertors="clr-namespace:MyProgram.Convertors"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1400">
    <UserControl.Resources>
        <convertors:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 从站列表项样式 -->
        <Style x:Key="SlaveListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 标题 -->
            <TextBlock 
                Grid.Row="0"
                Text="Modbus TCP 多从站工业监控系统" 
                FontSize="26" 
                FontWeight="Bold" 
                Foreground="#212121"
                Margin="10,0,0,20"/>

            <!-- 2. 配置区 + 从站列表 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="0.4*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：TCP 连接配置 -->
                <GroupBox Grid.Column="0" Header="通信参数配置">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IP 地址:" VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding IPAddress}" Margin="5,5" Height="30" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="端口号:" VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" Margin="5,5" Height="30" VerticalContentAlignment="Center"/>

                        <StackPanel Grid.Column="2" Margin="15,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="16" Height="16" Fill="{Binding ConnectionStatusColor}" Margin="0,0,8,0" Stroke="#BDBDBD" StrokeThickness="1"/>
                                <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                            <Button Content="连接设备" Command="{Binding ConnectCommand}" Background="#4CAF50" Foreground="White" BorderThickness="0"/>
                            <Button Content="断开连接" Command="{Binding DisconnectCommand}" Background="#F44336" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 中间：从站列表管理 -->
                <GroupBox Grid.Column="1" Header="从站设备列表">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 扫描范围配置 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="扫描范围:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ScanStartId}" VerticalContentAlignment="Center" Height="28"/>
                            <TextBlock Grid.Column="2" Text="-" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Grid.Column="3" Text="{Binding ScanEndId}" VerticalContentAlignment="Center" Height="28"/>
                        </Grid>

                        <!-- 从站列表 -->
                        <ListBox 
                            Grid.Row="1"
                            ItemsSource="{Binding SlaveDevices}"
                            SelectedItem="{Binding SelectedSlave}"
                            ItemContainerStyle="{StaticResource SlaveListItemStyle}"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0"
                            MaxHeight="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 在线状态指示灯 -->
                                        <Ellipse 
                                            Grid.Column="0"
                                            Width="10" 
                                            Height="10" 
                                            Fill="{Binding IsOnline, Converter={StaticResource BoolToColorConverter}}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>

                                        <!-- 从站 ID -->
                                        <TextBlock 
                                            Grid.Column="1"
                                            Text="{Binding SlaveId, StringFormat='站号: {0}'}"
                                            FontWeight="Bold"
                                            Width="60"
                                            VerticalAlignment="Center"/>

                                        <!-- 从站名称 -->
                                        <TextBlock 
                                            Grid.Column="2"
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center"
                                            Foreground="#616161"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 扫描/删除按钮 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="{Binding ScanButtonText}" 
                                    Command="{Binding ScanSlavesCommand}" 
                                    Background="#2196F3" 
                                    Foreground="White" 
                                    BorderThickness="0"/>
                            <Button Content="删除从站" 
                                    Command="{Binding RemoveSlaveCommand}" 
                                    CommandParameter="{Binding SelectedSlave}" 
                                    Background="#F44336" 
                                    Foreground="White" 
                                    BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 右侧：数据采集配置 -->
                <GroupBox Grid.Column="2" Header="采集与控制">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="起始地址:" VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StartAddress}" Margin="5,5" Height="30" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="读取数量:" VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegisterCount}" Margin="5,5" Height="30" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="写入数值:" VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding WriteValueInput}" 
                                 Margin="5,5" 
                                 Height="30" 
                                 VerticalContentAlignment="Center"
                                 helpers:TextBoxHelper.PlaceholderText="格式: value 或 value1,value2,value3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="轮询周期(ms):" VerticalAlignment="Center" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PollingInterval}" Margin="5,5" Height="30" VerticalContentAlignment="Center"/>

                        <StackPanel Grid.Column="2" Margin="15,0,0,0" VerticalAlignment="Center">
                            <Button Content="手动刷新" Command="{Binding ReadCommand}"/>
                            <Button Content="下发指令" Command="{Binding WriteCommand}" Background="#FF9800" Foreground="White" BorderThickness="0"/>
                            <Button Content="{Binding AutoPollingButtonText}" Command="{Binding ToggleAutoPollingCommand}" Background="#2196F3" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- 3. 工业仪表盘展示区 -->
            <GroupBox Grid.Row="2" Header="当前选中从站 - 工艺参数监控" Margin="0,15,0,0">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 仪表盘1：温度 -->
                    <Border Grid.Column="0" Margin="10" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="温度 (℃)" HorizontalAlignment="Center" FontSize="14" Foreground="#616161" Margin="0,0,0,10"/>
                            <lvc:AngularGauge 
                                Width="250"
                                Height="250"
                                Value="{Binding Temperature}" 
                                FromValue="0" 
                                ToValue="200" 
                                TicksForeground="#616161"
                                Wedge="300"
                                NeedleFill="#FF5722"
                                SectionsInnerRadius="0.85"
                                LabelsStep="40">
                                <lvc:AngularGauge.Sections>
                                    <lvc:AngularSection FromValue="0" ToValue="100" Fill="#4CAF50"/>
                                    <lvc:AngularSection FromValue="100" ToValue="150" Fill="#FF9800"/>
                                    <lvc:AngularSection FromValue="150" ToValue="200" Fill="#F44336"/>
                                </lvc:AngularGauge.Sections>
                            </lvc:AngularGauge>
                        </StackPanel>
                    </Border>

                    <!-- 仪表盘2：湿度 -->
                    <Border Grid.Column="1" Margin="10" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="湿度 (%)" HorizontalAlignment="Center" FontSize="14" Foreground="#616161" Margin="0,0,0,10"/>
                            <lvc:AngularGauge 
                                Width="250"
                                Height="250"
                                Value="{Binding Humidity}" 
                                FromValue="0" 
                                ToValue="100" 
                                TicksForeground="#616161"
                                Wedge="300"
                                NeedleFill="#2196F3"
                                SectionsInnerRadius="0.85"
                                LabelsStep="20">
                                <lvc:AngularGauge.Sections>
                                    <lvc:AngularSection FromValue="0" ToValue="40" Fill="#FF9800"/>
                                    <lvc:AngularSection FromValue="40" ToValue="70" Fill="#4CAF50"/>
                                    <lvc:AngularSection FromValue="70" ToValue="100" Fill="#2196F3"/>
                                </lvc:AngularGauge.Sections>
                            </lvc:AngularGauge>
                        </StackPanel>
                    </Border>

                    <!-- 仪表盘3：压力 -->
                    <Border Grid.Column="2" Margin="10" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="压力 (kPa)" HorizontalAlignment="Center" FontSize="14" Foreground="#616161" Margin="0,0,0,10"/>
                            <lvc:AngularGauge 
                                Width="250"
                                Height="250"
                                Value="{Binding Pressure}" 
                                FromValue="0" 
                                ToValue="1000" 
                                TicksForeground="#616161"
                                Wedge="300"
                                NeedleFill="#4CAF50"
                                SectionsInnerRadius="0.85"
                                LabelsStep="200">
                                <lvc:AngularGauge.Sections>
                                    <lvc:AngularSection FromValue="0" ToValue="600" Fill="#4CAF50"/>
                                    <lvc:AngularSection FromValue="600" ToValue="800" Fill="#FF9800"/>
                                    <lvc:AngularSection FromValue="800" ToValue="1000" Fill="#F44336"/>
                                </lvc:AngularGauge.Sections>
                            </lvc:AngularGauge>
                        </StackPanel>
                    </Border>

                    <!-- 仪表盘4：流量 -->
                    <Border Grid.Column="3" Margin="10" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="流量 (L/min)" HorizontalAlignment="Center" FontSize="14" Foreground="#616161" Margin="0,0,0,10"/>
                            <lvc:AngularGauge 
                                Width="250"
                                Height="250"
                                Value="{Binding Flow}" 
                                FromValue="0" 
                                ToValue="500" 
                                TicksForeground="#616161"
                                Wedge="300"
                                NeedleFill="#FF9800"
                                SectionsInnerRadius="0.85"
                                LabelsStep="100">
                                <lvc:AngularGauge.Sections>
                                    <lvc:AngularSection FromValue="0" ToValue="300" Fill="#4CAF50"/>
                                    <lvc:AngularSection FromValue="300" ToValue="400" Fill="#FF9800"/>
                                    <lvc:AngularSection FromValue="400" ToValue="500" Fill="#F44336"/>
                                </lvc:AngularGauge.Sections>
                            </lvc:AngularGauge>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- 4. 详细数据表格区 -->
            <GroupBox Grid.Row="3" Header="当前选中从站 - 寄存器原始数据" Margin="0,15,0,0">
                <DataGrid 
                    ItemsSource="{Binding Registers}" 
                    AutoGenerateColumns="False" 
                    IsReadOnly="True"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="寄存器地址" Binding="{Binding Address}" Width="0.3*"/>
                        <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="0.3*"/>
                        <DataGridTextColumn Header="参数描述" Binding="{Binding Description}" Width="0.4*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
